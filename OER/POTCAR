# pseudopotentials for Ir and O in the order they appear in POSCAR:
#
#   cat $VASP_PP_PATH/potpaw_PBE/Ir/POTCAR \
#       $VASP_PP_PATH/potpaw_PBE/O/POTCAR  \
#       > OER/POTCAR
